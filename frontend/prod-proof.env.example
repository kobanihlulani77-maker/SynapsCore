# Optional live hosted proof overrides.
# scripts/prepare-hosted-proof.ps1 is authoritative and writes generated proof
# state to frontend/.hosted-proof/hosted-proof-state.json when these are absent.
PLAYWRIGHT_BASE_URL=https://synapscore-frontend-3.onrender.com
PLAYWRIGHT_API_BASE_URL=https://synapscore-3.onrender.com

# Real proof tenant created through /api/access/tenants, not seed/demo data.
# Usually generated by scripts/prepare-hosted-proof.ps1.
# PLAYWRIGHT_TENANT_CODE=HOSTED-PROOF
# PLAYWRIGHT_PROOF_PRODUCT_SKU=SKU-HOSTED-PROOF-PROOF

# Usernames must contain only letters, digits, dots, underscores, and hyphens.
# Tenant admin: tenant bootstrap admin / access administrator.
# Usually generated/persisted by scripts/prepare-hosted-proof.ps1.
# PLAYWRIGHT_TENANT_ADMIN_USERNAME=hosted.proof.admin
# PLAYWRIGHT_TENANT_ADMIN_PASSWORD=<generated-secret-in-ignored-proof-state>

# Planner/operator: ordinary workspace operator used to prove non-admin access boundaries.
# PLAYWRIGHT_PLANNER_USERNAME=hosted.proof.planner
# PLAYWRIGHT_PLANNER_PASSWORD=<generated-secret-in-ignored-proof-state>

# Integration admin: connector/replay operator used to prove integration and recovery flows.
# PLAYWRIGHT_INTEGRATION_ADMIN_USERNAME=hosted.proof.integration
# PLAYWRIGHT_INTEGRATION_ADMIN_PASSWORD=<generated-secret-in-ignored-proof-state>

# Required only when the target production database has zero tenants.
# This is a private backend/Render secret and must never be committed.
# SYNAPSECORE_BOOTSTRAP_INITIAL_TOKEN=<private-render-backend-bootstrap-secret>
